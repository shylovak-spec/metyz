<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Контроль якості метизів та дюбелів</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f4f5f7; }
    </style>
</head>
<body class="p-4 max-w-md mx-auto min-h-screen flex flex-col justify-between">

    <div>
        <!-- HEADER -->
        <header class="mb-6 pt-2 text-center">
            <span class="text-[10px] font-bold tracking-widest text-gray-400 uppercase">Термінал ОТК</span>
            <h1 class="text-xl font-bold text-gray-900 mt-0.5">Критерії якості метизів/дюбелів</h1>
            <p class="text-xs text-gray-500 mt-1">Оберіть зону/елемент та дефект для перевірки</p>
        </header>

        <!-- STEP 1: ZONE SELECTOR -->
        <div class="mb-6">
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Крок 1. Оберіть зону або елемент</label>
            <div class="grid grid-cols-2 gap-2">
                <button id="btn-zone-thread" onclick="selectZone('thread')" class="zone-btn border-2 border-dashed border-gray-300 bg-white p-3 rounded-xl text-center transition-all active:scale-95">
                    <div class="text-xl mb-1">🔩</div>
                    <div class="font-bold text-xs">Зона різьби</div>
                </button>
                <button id="btn-zone-head" onclick="selectZone('head')" class="zone-btn border-2 border-dashed border-gray-300 bg-white p-3 rounded-xl text-center transition-all active:scale-95">
                    <div class="text-xl mb-1">🪙</div>
                    <div class="font-bold text-xs">Зона головки</div>
                </button>
                <button id="btn-zone-slot" onclick="selectZone('slot')" class="zone-btn border-2 border-dashed border-gray-300 bg-white p-3 rounded-xl text-center transition-all active:scale-95">
                    <div class="text-xl mb-1">➕</div>
                    <div class="font-bold text-xs">Зона шліцу</div>
                </button>
                <button id="btn-zone-dowel" onclick="selectZone('dowel')" class="zone-btn border-2 border-dashed border-gray-300 bg-white p-3 rounded-xl text-center transition-all active:scale-95">
                    <div class="text-xl mb-1">🧱</div>
                    <div class="font-bold text-xs">Дюбель</div>
                </button>
                <button id="btn-zone-tape" onclick="selectZone('tape')" class="zone-btn border-2 border-dashed border-gray-300 bg-white p-3 rounded-xl text-center transition-all active:scale-95">
                    <div class="text-xl mb-1">🎞️</div>
                    <div class="font-bold text-xs">Скотч</div>
                </button>
                <button id="btn-zone-anchor" onclick="selectZone('anchor')" class="zone-btn border-2 border-dashed border-gray-300 bg-white p-3 rounded-xl text-center transition-all active:scale-95">
                    <div class="text-xl mb-1">⚓</div>
                    <div class="font-bold text-xs">Анкер</div>
                </button>
                <button id="btn-zone-brass" onclick="selectZone('brass')" class="zone-btn border-2 border-dashed border-gray-300 bg-white p-3 rounded-xl text-center transition-all active:scale-95 col-span-2">
                    <div class="text-xl mb-1">🟡</div>
                    <div class="font-bold text-xs">Дюбель, латунь</div>
                </button>
            </div>
        </div>

        <!-- STEP 2: DEFECT SELECTOR -->
        <div id="step-defects" class="mb-6 opacity-40 pointer-events-none transition-all duration-300">
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Крок 2. Який дефект виявили?</label>
            <div class="space-y-2 max-h-[360px] overflow-y-auto pr-1">
                <button onclick="checkDefect(1)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">1. Тріщини</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(2)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">2. Жовтий колір метизу</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(3)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">3. Розводи</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(4)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">4. Невідповідність по розмірам</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(5)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">5. Дефект покриття (білі, чорні плями)</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(51)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">5.1. Дефект покриття (відшарування)</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(6)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">6. Забруднення</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(7)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">7. Іржа</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(9)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">9. Пошкоджена різьба</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(10)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">10. Раковини</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(11)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">11. Відсутність різьби</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(12)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">12. Різновідтінковість метизів</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(100)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">Сколи</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(13)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">13. Облой пластику</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(14)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">14. Деформація</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(15)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">15. Недолив</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(16)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">16. Пошкоджений шліц метизу</span>
                    <span class="text-gray-400">❯</span>
                </button>
                <button onclick="checkDefect(200)" class="defect-btn w-full bg-white p-3 rounded-xl text-left border border-gray-200 flex items-center justify-between shadow-sm active:bg-gray-50">
                    <span class="text-xs font-medium text-gray-800">Візуальна розмірна відмінність (Комбінаторика)</span>
                    <span class="text-gray-400">❯</span>
                </button>
            </div>
        </div>

        <!-- STEP 3: VERDICT CARD -->
        <div id="result-card" class="hidden transform transition-all duration-300 my-4"></div>
    </div>

    <!-- FOOTER -->
    <div class="text-center py-4 border-t border-gray-200 mt-6">
        <p class="text-[11px] text-gray-400">Стандарт якості ОТК • Метизи та дюбелі</p>
    </div>

    <script>
        let selectedZone = null;

        const notAllowed = { status: 'bad', title: 'НЕ ДОПУСКАЄТЬСЯ', desc: 'Дефект у даній зоні/елементі не допускається.' };
        const notApplicable = { status: 'none', title: 'НЕ ХАРАКТЕРНО / НЕ ЗУСТРІЧАЛОСЬ', desc: 'Даний дефект не зустрічається або не характерний для цієї зони.' };
        const allowUnlimited = { status: 'good', title: 'ДОПУСКАЄТЬСЯ', desc: 'Допускається не обмежено.' };
        const allowMountingSet = { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається тільки для комплектуючих, які використовують при формуванні монтажного комплекту.' };

        const db = {
            1: { thread: notAllowed, head: notAllowed, slot: notAllowed, dowel: notAllowed, tape: notAllowed, anchor: notAllowed, brass: notAllowed },
            2: { thread: notAllowed, head: notAllowed, slot: notAllowed, dowel: notApplicable, tape: notApplicable, anchor: notAllowed, brass: notAllowed },
            3: { thread: allowUnlimited, head: allowUnlimited, slot: allowUnlimited, dowel: allowUnlimited, tape: allowUnlimited, anchor: allowUnlimited, brass: allowUnlimited },
            4: { thread: allowMountingSet, head: allowMountingSet, slot: allowMountingSet, dowel: allowMountingSet, tape: allowMountingSet, anchor: allowMountingSet, brass: allowMountingSet },
            5: { thread: allowMountingSet, head: allowMountingSet, slot: allowMountingSet, dowel: allowMountingSet, tape: allowMountingSet, anchor: allowMountingSet, brass: allowMountingSet },
            51: {
                thread: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається лише для комплектуючих, що використовуються при складанні.' },
                head: notAllowed,
                slot: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається у внутрішній частині. Див. презентацію.' },
                dowel: notApplicable, tape: notApplicable,
                anchor: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається у внутрішній частині. Див. презентацію.' },
                brass: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається у внутрішній частині. Див. презентацію.' }
            },
            6: { thread: allowMountingSet, head: allowMountingSet, slot: allowMountingSet, dowel: allowMountingSet, tape: allowMountingSet, anchor: allowMountingSet, brass: allowMountingSet },
            7: {
                thread: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається тільки для комплектуючих, які використовують при формуванні монтажного комплекту.' },
                head: notAllowed, slot: notAllowed, dowel: notApplicable, tape: notApplicable,
                anchor: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається з внутрішньої частини.' },
                brass: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається з внутрішньої частини.' }
            },
            9: { thread: notAllowed, head: notApplicable, slot: notApplicable, dowel: notApplicable, tape: notApplicable, anchor: notAllowed, brass: notAllowed },
            10: { thread: allowUnlimited, head: allowUnlimited, slot: allowUnlimited, dowel: notApplicable, tape: notApplicable, anchor: allowUnlimited, brass: allowUnlimited },
            11: { thread: notAllowed, head: notApplicable, slot: notApplicable, dowel: notApplicable, tape: notApplicable, anchor: notAllowed, brass: notAllowed },
            12: { thread: allowUnlimited, head: allowUnlimited, slot: allowUnlimited, dowel: notApplicable, tape: notApplicable, anchor: allowUnlimited, brass: allowUnlimited },
            100: {
                thread: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається не обмежено за відсутності впливу на монтаж.' },
                head: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається не обмежено (за відсутності відшарувань для метизів з покриттям).' },
                slot: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається у внутрішній частині. Див. презентацію.' },
                dowel: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається не обмежено за відсутності впливу на монтаж.' },
                tape: notApplicable,
                anchor: allowUnlimited,
                brass: allowUnlimited
            },
            13: { thread: notApplicable, head: notApplicable, slot: notApplicable, dowel: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається за відсутності впливу на монтаж.' }, tape: notApplicable, anchor: notApplicable, brass: notApplicable },
            14: { thread: notApplicable, head: notApplicable, slot: notApplicable, dowel: notApplicable, tape: allowUnlimited, anchor: notApplicable, brass: notApplicable },
            15: { thread: notApplicable, head: notApplicable, slot: notApplicable, dowel: { status: 'good', title: 'ДОПУСКАЄТЬСЯ З УМОВОЮ', desc: 'Допускається ≤ 0.5 мм.' }, tape: notApplicable, anchor: notApplicable, brass: notApplicable },
            16: { thread: notApplicable, head: notApplicable, slot: { status: 'bad', title: 'ДИВ. ПРЕЗЕНТАЦІЮ / НЕ ДОПУСКАЄТЬСЯ', desc: 'Пошкоджений шліц метизу — див. деталі в презентації.' }, dowel: notApplicable, tape: notApplicable, anchor: notApplicable, brass: notApplicable },
            200: {
                thread: notApplicable,
                head: { status: 'bad', title: 'НЕ ДОПУСКАЄТЬСЯ', desc: 'Не допускається на одному девайсі.' },
                slot: { status: 'bad', title: 'НЕ ДОПУСКАЄТЬСЯ', desc: 'Не допускається на одному девайсі.' },
                dowel: notApplicable, tape: notApplicable, anchor: notApplicable, brass: notApplicable
            }
        };

        function selectZone(zone) {
            selectedZone = zone;
            
            document.querySelectorAll('.zone-btn').forEach(b => {
                b.classList.remove('border-black', 'bg-gray-900', 'text-white');
                b.classList.add('border-gray-300', 'bg-white', 'text-gray-800');
            });

            const activeBtn = document.getElementById(`btn-zone-${zone}`);
            if (activeBtn) {
                activeBtn.classList.remove('border-gray-300', 'bg-white', 'text-gray-800');
                activeBtn.classList.add('border-black', 'bg-gray-900', 'text-white');
            }

            const step2 = document.getElementById('step-defects');
            step2.classList.remove('opacity-40', 'pointer-events-none');

            document.getElementById('result-card').classList.add('hidden');
        }

        function checkDefect(id) {
            if (!selectedZone) return;

            const res = db[id]?.[selectedZone];
            const card = document.getElementById('result-card');

            if (!res) return;

            let bgColor = 'bg-emerald-600';
            let icon = '✅';

            if (res.status === 'bad') {
                bgColor = 'bg-red-500';
                icon = '⛔';
            } else if (res.status === 'none') {
                bgColor = 'bg-gray-500';
                icon = '⚙️';
            }

            card.innerHTML = `
                <div class="${bgColor} text-white p-4 rounded-2xl shadow-lg">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-xl">${icon}</span>
                        <h2 class="font-extrabold text-base tracking-wide uppercase">${res.title}</h2>
                    </div>
                    <p class="text-xs font-medium opacity-95 whitespace-pre-line leading-tight border-t border-white/20 pt-1 mt-0.5">${res.desc.trim()}</p>
                </div>
            `;
            card.classList.remove('hidden');
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    </script>
</body>
</html>
